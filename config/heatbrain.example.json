{
  "_comment": "Copied to <data-dir>/heatbrain.json on first run. Edit that copy, not this file.",
  "timezone": "Europe/Copenhagen",
  "currency": "DKK",
  "price": {
    "_comment": "Additive components (per kWh, excl. VAT), then surcharges applied in order.",
    "components": [
      {
        "type": "energidataservice.spot",
        "name": "Spot",
        "area": "DK2"
      },
      {
        "type": "energidataservice.tariff",
        "name": "Nettarif (Radius C)",
        "gln": "5790000705689",
        "codes": [
          "DT_C_01"
        ]
      },
      {
        "type": "energidataservice.tariff",
        "name": "Energinet",
        "_comment": "40000 = Transmissions nettarif, 41000 = Systemtarif",
        "gln": "5790000432752",
        "codes": [
          "40000",
          "41000"
        ]
      },
      {
        "type": "fixed",
        "name": "Elafgift",
        "_comment": "Statutory electricity tax per kWh excl. VAT. Verify against your bill.",
        "amount": 0.008
      },
      {
        "type": "fixed",
        "name": "EWII tillæg",
        "_comment": "Supplier markup per kWh excl. VAT from your EWII contract.",
        "amount": 0.0
      }
    ],
    "surcharges": [
      {
        "name": "Moms",
        "percent": 25
      }
    ]
  },
  "plugs": [
    {
      "_comment": "Find plugs with 'heatbrain discover 192.168.1.0/24'. mode: dryrun (never switched) or live.",
      "id": "bedroom",
      "name": "Bedroom radiator",
      "type": "tasmota",
      "host": "192.168.1.38",
      "mode": "dryrun",
      "failsafe": {
        "_comment": "Auto-off after pulseMinutes without refresh; limp mode after watchdogMinutes of silence.",
        "pulseMinutes": 20,
        "watchdogMinutes": 30,
        "limpOnMinutes": 10,
        "limpOffMinutes": 50
      }
    },
    {
      "id": "test",
      "name": "Simulated plug for development",
      "type": "simulated",
      "mode": "live"
    }
  ],
  "temperatureSources": [
    {
      "_comment": "Create an app at https://dev.netatmo.com/apps, then use the app page's Token generator with scope read_station. refreshToken is only used once: heatbrain stores the rotating tokens in data/netatmo-tokens.json.",
      "id": "netatmo",
      "type": "netatmo",
      "clientId": "",
      "clientSecret": "",
      "refreshToken": ""
    }
  ],
  "control": {
    "_comment": "tickSeconds must be at most half of each live plug's failsafe pulse.",
    "tickSeconds": 300
  },
  "rooms": [
    {
      "id": "bedroom",
      "name": "Bedroom",
      "plugs": [
        "bedroom"
      ],
      "sensor": "netatmo:Bedroom",
      "minTemp": 16,
      "maxTemp": 22,
      "schedule": [
        {
          "from": "07:00",
          "to": "21:00",
          "target": 19
        },
        {
          "from": "21:00",
          "to": "23:00",
          "target": 20
        },
        {
          "from": "23:00",
          "to": "07:00",
          "target": 16
        }
      ]
    },
    {
      "id": "basement",
      "name": "Basement",
      "plugs": [
        "basement"
      ],
      "sensor": "netatmo:Basement",
      "minTemp": 15,
      "maxTemp": 22,
      "schedule": [
        {
          "from": "00:00",
          "to": "24:00",
          "target": 19
        }
      ]
    },
    {
      "id": "shed",
      "name": "Shed",
      "plugs": [
        "shed"
      ],
      "_comment": "No temperature sensor: run the cheapest hours of each day, never 17-21.",
      "priceOnly": {
        "hoursPerDay": 12,
        "avoid": [
          {
            "from": "17:00",
            "to": "21:00"
          }
        ]
      }
    }
  ],
  "notifications": {
    "_comment": "Discord: Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL. Test with 'heatbrain notify-test'.",
    "channels": [
      {
        "type": "discord",
        "webhookUrl": ""
      }
    ],
    "repeatHours": 6,
    "quietHours": {
      "from": "23:00",
      "to": "07:00"
    },
    "notifyOnStart": true
  },
  "_example_schedule_component": {
    "_comment": "For grid companies without an API: describe the tariff directly.",
    "type": "schedule",
    "name": "Grid tariff",
    "seasons": [
      {
        "months": [
          10,
          11,
          12,
          1,
          2,
          3
        ],
        "bands": [
          {
            "from": "00:00",
            "to": "06:00",
            "amount": 0.106
          },
          {
            "from": "06:00",
            "to": "17:00",
            "amount": 0.319
          },
          {
            "from": "17:00",
            "to": "21:00",
            "amount": 0.956
          },
          {
            "from": "21:00",
            "to": "24:00",
            "amount": 0.319
          }
        ]
      }
    ]
  },
  "_example_room_strategy": {
    "_comment": "Optional per-room 'strategy' (defaults shown).",
    "hysteresis": 0.3,
    "peakAllowedDrop": 1.0,
    "preheatBoost": 1.0,
    "preheatMinutes": 180,
    "cheapBoost": 0.5,
    "staleMinutes": 30,
    "limpOnMinutes": 10,
    "limpOffMinutes": 50
  }
}
